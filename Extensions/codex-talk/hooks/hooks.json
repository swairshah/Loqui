{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/user_prompt_submit.js\"",
            "timeout": 5,
            "statusMessage": "Checking Loqui"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/post_tool_use.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/stop.js\"",
            "timeout": 10,
            "statusMessage": "Sending voice output"
          }
        ]
      }
    ]
  }
}
